# Mobile App Environment Configuration

# API Base URL
# For development:
#   - Android Emulator: http://10.0.2.2:8080/api
#   - iOS Simulator: http://localhost:8080/api
#   - Physical Device: http://YOUR_COMPUTER_IP:8080/api
# For production: https://your-production-api.com/api
API_BASE_URL=

# Build configuration
# To use: flutter build apk --dart-define=API_BASE_URL=https://your-api.com/api
